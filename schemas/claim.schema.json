{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Claim (layer 1 node, managed by a person)",
  "type": "object",
  "required": [
    "id",
    "text",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^claim:"
    },
    "text": {
      "type": "string",
      "description": "The research claim in one line"
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "hold",
        "retired"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "text"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "changed_at": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "description": "Your own experiments. Kept only in the private data repository.",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "setup": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "status": {
            "enum": [
              "plan",
              "running",
              "done"
            ],
            "description": "계획 / 진행 중 / 완료"
          }
        }
      }
    },
    "memo": {
      "type": "string"
    },
    "origin": {
      "enum": [
        "manual",
        "ai"
      ],
      "description": "ai = 연구 주제 추천 버튼이 만든 후보"
    },
    "basis": {
      "type": "string",
      "description": "근거: why it should work and what nobody has done yet"
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Papers used to propose it"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "model": {
      "type": "string"
    }
  }
}
